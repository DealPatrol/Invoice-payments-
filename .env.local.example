# Keyless preview only. Set false (or remove) when DATABASE_URL is configured.
DEMO_MODE=true

# Supabase Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth credentials authentication.
NEXTAUTH_SECRET="generate-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# Stripe invoice payments and recurring billing.
# Prefer a restricted key with only the permissions Invoice Jot uses.
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_GROWTH_PRICE_ID="price_..."
STRIPE_SCALE_PRICE_ID="price_..."

# Resend payment reminders.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Invoice Jot <billing@your-verified-domain.com>"

# Protects GET /api/cron/reminders.
CRON_SECRET="generate-another-long-random-value"

# --- Invoice Studio (all off by default) ---
# Online payments from secure client links (/i/<token>). Test keys only unless STUDIO_ALLOW_LIVE_STRIPE=true.
STUDIO_CHECKOUT_ENABLED=false
STUDIO_ALLOW_LIVE_STRIPE=false
# Email sending: provider = log (default, sends nothing) | resend | agentmail
STUDIO_EMAIL_ENABLED=false
STUDIO_EMAIL_PROVIDER=log
STUDIO_EMAIL_ALLOWLIST=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Photo-to-estimate. Leave blank (or keep DEMO_MODE=true) to use the built-in structured demo draft.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional finished-job preview. Leave blank to show an original schematic instead.
REPLICATE_API_TOKEN=

# --- Invoice Jot "Get paid with card" (Stripe Connect) — see STRIPE_CONNECT.md ---
# STRIPE_SECRET_KEY above is the platform key (restricted rk_test_... recommended).
INVOICEJOT_LINK_SECRET=""            # 32+ random chars: openssl rand -base64 48 (do not rotate casually)
STRIPE_CONNECT_WEBHOOK_SECRET=""     # whsec_... of the Connect endpoint /api/connect/webhook
INVOICEJOT_PLATFORM_FEE_BPS="100"    # 100 = 1%
# INVOICEJOT_CONNECT_ALLOW_LIVE="true"  # only when going live; live keys are refused otherwise
# INVOICEJOT_CONNECT_ORIGINS=""      # extra CORS origins; capacitor://localhost is allowed by default
