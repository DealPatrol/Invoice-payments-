# Keyless preview only. Set false (or remove) when DATABASE_URL is configured.
DEMO_MODE=true

# Supabase Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth credentials authentication.
NEXTAUTH_SECRET="generate-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

# Stripe invoice payments and recurring billing.
# Prefer a restricted key with only the permissions InvoiceOS uses.
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID="price_..."
STRIPE_GROWTH_PRICE_ID="price_..."
STRIPE_SCALE_PRICE_ID="price_..."

# Resend payment reminders.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="InvoiceOS <billing@your-verified-domain.com>"

# Protects GET /api/cron/reminders.
CRON_SECRET="generate-another-long-random-value"
