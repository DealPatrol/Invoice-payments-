// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  name                 String?
  company              String?
  taxId                String?
  address              String?
  bankAccount          String?
  plan                 String    @default("starter")
  subscriptionStatus   String    @default("inactive")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  invoices             Invoice[]
  clients              Client[]
  payments             Payment[]
}

model Client {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  country     String
  currency    String    @default("USD")
  taxId       String?
  address     String?
  phone       String?
  totalBilled Float     @default(0)
  totalPaid   Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]

  @@unique([userId, email])
  @@index([userId])
}

model Invoice {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber     String
  payToken          String        @unique @default(cuid())
  status            String        @default("draft")
  currency          String        @default("USD")
  amount            Float
  tax               Float         @default(0)
  total             Float
  issueDate         DateTime
  dueDate           DateTime
  paidDate          DateTime?
  network           String?
  notes             String?
  templateId        String?
  recurring         Boolean       @default(false)
  lateFeePercent    Float         @default(0)
  payScore          Int           @default(70)
  stripeSessionId   String?       @unique
  lastReminderAt    DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             InvoiceItem[]
  payments          Payment[]
  reminderLogs      ReminderLog[]

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@unique([userId, invoiceNumber])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  taxRate     Float   @default(0)
  total       Float

  @@index([invoiceId])
}

model Payment {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount                Float
  method                String
  status                String   @default("pending")
  stripePaymentIntentId String?  @unique
  stripeCheckoutId      String?  @unique
  reference             String?
  paidAt                DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([invoiceId])
  @@index([status])
}

model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model ReminderLog {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String
  sentTo    String
  sentAt    DateTime @default(now())

  @@index([invoiceId])
  @@unique([invoiceId, kind, sentAt])
}
